# Copia questo file in .env e modifica i valori.
# Il file .env NON va mai committato (è in .gitignore).

# Database
POSTGRES_DB=plannershop
POSTGRES_USER=plannershop
POSTGRES_PASSWORD=cambiami-con-una-password-lunga
POSTGRES_PORT=5432

# Sicurezza
# Segreto per firmare i token di accesso: stringa casuale lunga.
# Generane uno con:  openssl rand -base64 48
# Se vuoto se ne genera uno a ogni avvio (gli utenti dovranno riaccedere dopo un riavvio).
JWT_SECRET=

# Modalità di installazione:
#   cloud  = piattaforma con più attività, gestite dal SUPERADMIN
#   locale = installazione sul PC di un'unica attività (niente SUPERADMIN)
# Va scelta PRIMA del primo avvio: decide quali utenti vengono creati.
APP_MODALITA=cloud

# --- Solo modalità cloud ---
# SUPERADMIN creato al primo avvio (solo se il database non ha utenti).
# Se la password è vuota ne viene generata una e scritta nel log del backend:
#   docker compose logs backend | grep -A3 SUPERADMIN
SUPERADMIN_EMAIL=admin@plannershop.local
SUPERADMIN_PASSWORD=

# --- Solo modalità locale ---
# Attività e suo ADMIN creati al primo avvio (solo se il database non ha utenti).
# La password è sempre provvisoria: il cliente la cambia al primo accesso.
# Se vuota viene generata e scritta nel log:
#   docker compose logs backend | grep -A4 "Installazione locale"
ATTIVITA_NOME=La mia attività
ADMIN_EMAIL=admin@plannershop.local
ADMIN_NOME=Amministratore
ADMIN_PASSWORD=

# Porta su cui l'applicazione risponde (http://localhost:APP_PORT)
APP_PORT=8090

# Fuso orario dei container
TZ=Europe/Rome
