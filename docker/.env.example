# Copy this file to .env and change the values.
# The .env file must NEVER be committed (it is in .gitignore).

# Database
POSTGRES_DB=plannershop
POSTGRES_USER=plannershop
POSTGRES_PASSWORD=change-me-with-a-long-password
POSTGRES_PORT=5432

# Security
# Secret used to sign the access tokens: a long random string.
# Generate one with:  openssl rand -base64 48
# If empty, a new one is generated at every start (users must sign in again after a restart).
JWT_SECRET=

# Installation mode:
#   cloud = platform with many businesses, managed by the SUPERADMIN
#   local = installed on the PC of a single business (no SUPERADMIN)
# Choose it BEFORE the first start: it decides which users are created.
APP_MODE=cloud

# --- Cloud mode only ---
# SUPERADMIN created on first start (only if the database has no users).
# If the password is empty, one is generated and written to the backend log:
#   docker compose logs backend | grep -A3 SUPERADMIN
SUPERADMIN_EMAIL=admin@plannershop.local
SUPERADMIN_PASSWORD=
# Name shown in the top bar
SUPERADMIN_NAME=Platform administrator

# --- Local mode only ---
# Business and its ADMIN created on first start (only if the database has no users).
# The password is always temporary: the customer changes it at first sign-in.
# If empty, it is generated and written to the log:
#   docker compose logs backend | grep -A4 "Local installation"
ACTIVITY_NAME=My business
ADMIN_EMAIL=admin@plannershop.local
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# Port the application answers on (http://localhost:APP_PORT)
APP_PORT=8090

# Time zone of the containers
TZ=Europe/Rome
